# ─────────────────────────────────────────────────────────────────────────────
# alkan-finance-signal-actor — environment variables
#
# Copy to `.env` for local development. In Apify, set these as Actor
# *secret environment variables* (Actor → Settings → Environment variables),
# NOT in the run input. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Optional Socrata app token. The Actor works WITHOUT it at low volume; a token
# raises the public rate limit. Request one at https://data.seattle.gov (free).
SOCRATA_APP_TOKEN=

# ALKAN private ingestion endpoint (HTTPS URL). If missing, the Actor stays in
# dry-run mode and performs NO delivery.
ALKAN_INGEST_URL=

# Shared secret used to HMAC-sign delivery payloads. If missing, the Actor stays
# in dry-run mode and performs NO delivery.
ALKAN_WEBHOOK_SECRET=

# Tenant identifier sent in the X-Alkan-Tenant header.
ALKAN_TENANT_ID=

# Feature flag for the (not-yet-implemented) AI enrichment interface.
# Must remain false in this version; no paid AI APIs are called.
ENABLE_AI_ENRICHMENT=false

# Optional log level: debug | info | warn | error (default: info).
LOG_LEVEL=info
